[Unit]
Description=WebKVM Backend (libvirt management + embedded Svelte frontend)
Documentation=https://github.com/Slaker19/webkvm
After=libvirtd.service virtlogd.service network-online.target local-fs.target remote-fs.target
Wants=libvirtd.service virtlogd.service network-online.target

[Service]
Type=simple
User=root
Group=root
# Repo and data dirs can be overridden by /etc/default/webkvm
# (sourced via EnvironmentFile).
EnvironmentFile=-/etc/default/webkvm
# Defaults if EnvironmentFile is missing.
Environment=DATA_DIR=/opt/webkvm
Environment=REPO_DIR=/opt/webkvm/source
# Self-update from /#/status. The backend refuses to run the updater unless
# this is "1" (install.sh writes the same line into the standalone unit).
# Disable it with a drop-in if an admin session must not be able to install
# software as root.
Environment=WEBKVM_ALLOW_UPDATE=1
# Bind on loopback only — the front-end (Caddy on :443) is the
# only thing that should reach the backend. Operators running
# without a front proxy can override this with a drop-in setting
# BIND_ADDR=0.0.0.0.
Environment=BIND_ADDR=0.0.0.0
# Go's multipart parser and os.CreateTemp use os.Tmpdir() (= $TMPDIR).
# On many distros /tmp is a small tmpfs; /var/tmp is on the root
# filesystem and has room for multi-GB uploads.
Environment=TMPDIR=/var/tmp
WorkingDirectory=/opt/webkvm
ExecStart=/usr/local/bin/webkvm
# Reload is intentionally a no-op — config is loaded once at startup.

# Auto-restart on failure; brief backoff to avoid tight loops.
Restart=always
RestartSec=5
TimeoutStopSec=30
LimitNOFILE=65536

# Logs go through journald. The companion logrotate file is a no-op
# (missingok) and is kept only for installations that switch to file
# logging via an override.
StandardOutput=journal
StandardError=journal
SyslogIdentifier=webkvm

# Hardening. The backend must run as root to read libvirt-owned image
# files, so we explicitly grant the required paths and isolate the rest.
# The set of writable paths is intentionally narrow; if you need to
# import VMs from extra locations, drop a drop-in or set DATA_DIR
# accordingly and add the parent to ReadWritePaths.
# Note: NoNewPrivileges and RestrictSUIDSGID are false to allow PAM /bin/login
# to authenticate and drop privileges to the logged-in system user.
NoNewPrivileges=false
ProtectSystem=full
ProtectHome=false
# Uploads use TMPDIR=/var/tmp and the app only needs its own files there.
PrivateTmp=true
ProtectKernelTunables=false
# Kept false: mdraid.go runs "modprobe md_mod/raid*", which needs module
# loading. ZFS/zvol tooling also relies on it.
ProtectKernelModules=false
ProtectControlGroups=false
RestrictSUIDSGID=false
ProtectHostname=true
ProtectClock=true
RestrictRealtime=true
LockPersonality=true
# UMask=0077 is deliberately NOT set: the backend creates storage-pool and
# mountpoint directories with MkdirAll(0755) (libvirt/connect.go, storage.go,
# smb_mount.go) that the qemu user must be able to traverse; a 0077 umask
# would turn them into 0700 and VMs would fail to start. Sensitive files are
# created 0600 explicitly in code instead. A drop-in can set it once pool
# directory modes are made explicit.
SystemCallArchitectures=native
MemoryDenyWriteExecute=false
RestrictNamespaces=false
# Paths the backend writes: data dir, libvirt images, uploads, credentials,
# mount units (/etc/systemd/system), mdadm.conf, host netplan bridges and
# its logs. The "-" prefix tolerates a path that does not exist (otherwise
# startup fails with 226/NAMESPACE).
ReadWritePaths=/opt/webkvm /var/lib/libvirt /var/tmp /etc/webkvm /etc/systemd/system -/etc/mdadm -/etc/netplan -/var/log/webkvm -/var/lib/incus
CapabilityBoundingSet=CAP_NET_ADMIN CAP_NET_RAW CAP_DAC_OVERRIDE CAP_DAC_READ_SEARCH CAP_SYS_ADMIN CAP_CHOWN CAP_FOWNER CAP_SETUID CAP_SETGID CAP_KILL CAP_SYS_PTRACE CAP_SYS_RESOURCE CAP_AUDIT_WRITE CAP_MKNOD CAP_SYS_RAWIO
AmbientCapabilities=

[Install]
WantedBy=multi-user.target
