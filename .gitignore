# Binaries: backend/webkvm y webkvm-cli SÍ se versionan (los
# necesita el instalador standalone al clonar en el destino).
backend/webkvm-new
backend/projecto-backend
backend/server
*.exe
*.test

# Go
vendor/

# Frontend
frontend/node_modules/
frontend/dist/
frontend/.svelte-kit/

# Logs
*.log
/tmp/

# Environment / secrets
.env
.env.local
.env.*.local
!.env.example

# Claude Code session context: accumulates real operational details
# over time (test-host IP/SSH/sudo passwords, admin credentials) and
# must never be committed to a public repo.
CLAUDE.md

# TLS certs (self-signed, host-specific, generated on first deploy)
certs/
*.pem
!scripts/Caddyfile

# OS
.DS_Store
Thumbs.db

# IDE
.vscode/
.idea/
*.swp
*.swo

# Debian package build artifacts (generated by make deb)
usr/sbin/webkvm
usr/lib/systemd/system/webkvm.service
backend/internal/frontend/dist/

# QA / dev artifacts (never publish)
frontend/qa-*.js
frontend/shots/
*.coverage.out
coverage.out

# Installer test artifacts
packaging/standalone/*.tmp
/install.log
