# Build outputs: backend/webkvm and backend/webkvm-cli are NEVER committed.
# Release binaries are published as GitHub Release assets (release.yml);
# the standalone installer downloads them or takes WEBKVM_BINARY=<path>.
backend/webkvm
backend/webkvm-cli
backend/webkvm-new
backend/projecto-backend
backend/server
backend/bin/
backend/webkvm-server
*.exe
*.test

# Go
vendor/

# Frontend
node_modules/
frontend/dist/
frontend/.svelte-kit/

# Logs
*.log
/tmp/

# Environment / secrets
.env
.env.local
.env.*.local
!.env.example

# Local development context — never committed.
CLAUDE.md

# TLS certs (self-signed, host-specific, generated on first deploy)
certs/
*.pem
!scripts/Caddyfile

# OS
.DS_Store
Thumbs.db

# IDE
.vscode/
.idea/
*.swp
*.swo

